# Coverage of the plugin scripts (CI: azure-pipelines.yml). Hooks run in subprocesses are counted
# when COVERAGE_PROCESS_START points to this file (tests/sitecustomize.py starts coverage there).
[run]
source =
    scripts
    skills/project-onboarding/scripts
parallel = True
relative_files = True

[report]
show_missing = False
skip_covered = False
